# ─── EmpX UI environment variables ───────────────────────────────────────────
#
# Copy this file to `.env.local` (gitignored) and fill in the values you need.
# Vite only exposes vars prefixed with VITE_ to client-side code.

# ─── Swap SDK affiliate fee ─────────────────────────────────────────────────
# When set, every swap routed through this dApp directs a portion of the
# protocol fee to this address.  The address MUST be payable on every chain
# the dApp supports — same address, same private key.  (Use a multisig
# or a dedicated EOA you control.)
#
# Without these, the swap SDK runs with no affiliate (zero share).
VITE_EMPX_AFFILIATE_ADDRESS=
#
# Basis points of the protocol fee redirected to the affiliate.  Default
# 2000 (= 20% of the protocol fee) if address is set but bps is omitted.
VITE_EMPX_AFFILIATE_FEE_BPS=2000

VITE_WALLETCONNECT_PROJECT_ID=

# Cross-chain engines on /cross-v2: "v1" (default), "v2", or "v1,v2" for a V1 | V2 toggle (testing).
# VITE_CROSS_ENGINES=v1,v2
#
# The browser never holds a V2 key: it calls the same-origin proxy /api/cross-v2/* (api/ Vercel function in prod,
# vite.config.js in dev), which adds the key server-side. These two have NO VITE_ prefix, so Vite never bundles them.
# On Vercel, set them in Project Settings -> Environment Variables (server-side); locally, put them in .env.local.
# EMPX_V2_API_BASE_URL=https://crosschain-v2.empx.io
# EMPX_V2_API_KEY=
