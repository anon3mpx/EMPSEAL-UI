{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/design-system/**/*",
    "src/lib/**/*",
    "src/hooks/swap/**/*",
    "src/hooks/useChainConfig.ts",
    "src/hooks/usePriceMonitor.ts",
    "src/utils/swap/**/*",
    "src/utils/pricing/**/*",
    "src/utils/priceFetcher.js",
    "src/utils/getChainConfig.ts",
    "src/features/cross/**/*",
    "src/config/**/*",
    "src/components/ErrorBoundary.jsx",
    "src/components/EmptyState.jsx",
    "src/components/EmpxModal.jsx",
    "src/components/FirstTimeTokenWarning.jsx",
    "src/components/SwapWarningBanner.jsx",
    "src/components/TokenSafetyBadge.jsx",
    "src/components/TouchTooltip.jsx",
    "src/components/DestinationAddressInput.jsx",
    "src/components/TokenLogo.tsx",
    "src/components/TokenLogo.jsx",
    "src/services/**/*",
    "src/test/**/*",
    "src/main.jsx",
    "src/App.jsx"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
